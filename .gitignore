.venv/
node_modules/
.next/
__pycache__/
.env
.env.*
!.env.example

# Raw PDFs
data/raw/*
backend/data/raw/*

# Processed files (ignore heavy temporary files, but keep the prebuilt tfidf index)
data/processed/*
!data/processed/tfidf_index.json

backend/data/processed/*
!backend/data/processed/tfidf_index.json
